// Mzito AI Bot (Zoho Cliq) -> Message Handler
//
// Bot: Mzito  |  Team: Digital Division  |  DC: com
// API endpoint (outbound from this service): https://cliq.zoho.com/api/v2/bots/mzito/message
//
// Paste this into: Integrations -> Bots -> Mzito -> Handlers -> Message Handler
// This script runs inside Cliq whenever a user messages Mzito; it forwards the
// message to the FastAPI helpdesk service and returns the reply.
//
// 1. Set WEBHOOK_URL to your deployed API (must be HTTPS — Cliq invokeUrl requires it).
// 2. Set WEBHOOK_SECRET to the same value as WEBHOOK_SHARED_SECRET on Render.
// 3. Publish the handler, then DM Mzito to test.

WEBHOOK_URL = "https://mzitoaiservice.onrender.com/webhooks/cliq";
WEBHOOK_SECRET = "replace-with-a-long-random-value"; // must match WEBHOOK_SHARED_SECRET on Render

response = Map();

// In Cliq Message Handlers, `message` is the plain text string (not a Map).
messageText = message;
messageMap = Map();
messageMap.put("text", messageText);

// Build a clean JSON-safe user object — do not pass Cliq's raw `user` map through
// toString(); it can break JSON serialization.
userPayload = Map();
if(user.containsKey("id"))
{
	userPayload.put("id", user.get("id").toString());
}
displayName = "User";
if(user.containsKey("first_name") && user.get("first_name") != null)
{
	displayName = user.get("first_name");
	if(user.containsKey("last_name") && user.get("last_name") != null)
	{
		displayName = displayName + " " + user.get("last_name");
	}
}
userPayload.put("name", displayName);
if(user.containsKey("email_id"))
{
	userPayload.put("email", user.get("email_id"));
}
else if(user.containsKey("email"))
{
	userPayload.put("email", user.get("email"));
}

requestBody = Map();
requestBody.put("text", messageText);
requestBody.put("message", messageMap);
requestBody.put("user", userPayload);
requestBody.put("chat_id", chat.get("id").toString());
requestBody.put("webhook_secret", WEBHOOK_SECRET);

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-Webhook-Secret", WEBHOOK_SECRET);

try
{
	apiResponse = invokeUrl
	[
		url: WEBHOOK_URL
		type: POST
		parameters: requestBody.toString()
		headers: headers
	];

	parsed = apiResponse.toMap();

	if(parsed.containsKey("text"))
	{
		response.put("text", parsed.get("text"));
	}
	if(parsed.containsKey("card"))
	{
		response.put("card", parsed.get("card"));
	}
	if(parsed.containsKey("buttons"))
	{
		response.put("buttons", parsed.get("buttons"));
	}
	if(response.size() == 0)
	{
		errorText = "Sorry, I did not get a valid reply from the helpdesk service.";
		if(parsed.containsKey("detail"))
		{
			errorText = errorText + " (" + parsed.get("detail") + ")";
		}
		response.put("text", errorText);
	}
}
catch (e)
{
	response.put("text", "The helpdesk assistant is temporarily unavailable. Please try again shortly, or use the Freshservice portal.");
}

return response;
