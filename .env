# --- App ---
APP_ENV=development
APP_NAME="Mzito AI Helpdesk Assistant"
PUBLIC_BASE_URL="https://mzitoaiservice.onrender.com"
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Auth: required. Sent by the Deluge Message Handler as X-Webhook-Secret ---
WEBHOOK_SHARED_SECRET=replace-with-a-long-random-value
# Optional, only if you front this with a Cliq Extension instead of a plain bot
# CLIQ_SIGNING_KEY=

# --- Freshservice ---
FRESHSERVICE_DOMAIN="davisandshirtliff.freshservice.com"
FRESHSERVICE_API_KEY="yw9cZKP-pr_lz_7VJo1w"
FRESHSERVICE_WORKSPACE_ID="27001710509"
DEFAULT_TICKET_PRIORITY=1
DEFAULT_TICKET_STATUS=2
DEFAULT_TICKET_SOURCE=2
KB_RESULT_LIMIT=3
REQUEST_TIMEOUT_SECONDS=20
FRESHSERVICE_MAX_RETRIES=3
FRESHSERVICE_RETRY_BASE_DELAY=0.5

# Optional keyword-based ticket routing, JSON: keyword -> {group_id, category}
# TICKET_ROUTING_RULES={"vpn": {"group_id": 12, "category": "Network"}, "payroll": {"group_id": 7, "category": "HR Systems"}}

# --- Cliq outbound (optional; only needed for async/proactive replies) ---
# Mzito bot endpoints (zoho.com DC):
#   Message API:    https://cliq.zoho.com/api/v2/bots/mzito/message
#   Incoming hook:  https://cliq.zoho.com/api/v2/bots/mzito/incoming
CLIQ_BOT_UNIQUE_NAME=mzito
# CLIQ_WEBHOOK_TOKEN=create under Integrations -> Webhook Tokens in Zoho Cliq
CLIQ_DC=com

# --- Conversation sessions ---
SESSION_BACKEND=memory
# SESSION_BACKEND=redis
# REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=600

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Escalation ---
NO_KB_RESULT_STREAK_BEFORE_ESCALATION=2
# ESCALATION_GROUP_ID=
